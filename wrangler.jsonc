{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decorateursgids",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "decorateursgids.be", "custom_domain": true },
    { "pattern": "www.decorateursgids.be", "custom_domain": true }
  ]
}
